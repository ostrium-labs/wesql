# A started server that is not read-only is ready.
SHOW GLOBAL STATUS LIKE 'Wesql_ready_for_write';
Variable_name	Value
Wesql_ready_for_write	ON
SELECT VARIABLE_VALUE FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Wesql_ready_for_write';
VARIABLE_VALUE
ON
# read_only and super_read_only make it not ready.
SET GLOBAL read_only = ON;
SHOW GLOBAL STATUS LIKE 'Wesql_ready_for_write';
Variable_name	Value
Wesql_ready_for_write	OFF
SET GLOBAL read_only = OFF;
SHOW GLOBAL STATUS LIKE 'Wesql_ready_for_write';
Variable_name	Value
Wesql_ready_for_write	ON
SET GLOBAL super_read_only = ON;
SHOW GLOBAL STATUS LIKE 'Wesql_ready_for_write';
Variable_name	Value
Wesql_ready_for_write	OFF
SET GLOBAL super_read_only = OFF;
SET GLOBAL read_only = OFF;
SHOW GLOBAL STATUS LIKE 'Wesql_ready_for_write';
Variable_name	Value
Wesql_ready_for_write	ON
