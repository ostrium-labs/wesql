include/assert.inc [gtid_executed is the same as before the crash]
include/assert.inc [gtid_purged is the same as before the crash]
# The server takes new writes after recovery.
INSERT INTO t1 VALUES (4, 'after recovery');
SELECT COUNT(*) FROM t1;
COUNT(*)
5
DROP TABLE t1, t2, t3;
SET GLOBAL snapshot_archive = ON;
